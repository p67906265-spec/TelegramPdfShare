<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Impostazioni"
            android:textColor="@color/white"
            android:textSize="27sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gruppo Telegram"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textSearchChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Nessun gruppo selezionato"
                android:textColor="@color/cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonSelectTelegramGroup"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Cambia gruppo Telegram"
                android:textAllCaps="false"
                android:textColor="@color/cyan"
                android:textStyle="bold" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Messaggi di controllo Telegram"
                android:textColor="@color/cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Destinazione: Messaggi salvati"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="I messaggi di verifica vengono inviati direttamente alla tua chat Messaggi salvati di Telegram."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/checkControlMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Invia messaggi di controllo"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ricerca automatica"
                android:textColor="@color/cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Parole da NON trovare • filtro unico"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editGlobalExclude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="es. napoli, roma, milano, torino"
                android:inputType="text"
                android:maxLines="3"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Puoi separare le parole con spazio, virgola, punto e virgola o andare a capo."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Minuti tra una ricerca e l'altra"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editRetryMinutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="15"
                android:inputType="number"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textStartTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ora di inizio: non impostata"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonPickStartTime"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Imposta ora di inizio"
                android:textAllCaps="false"
                android:textColor="@color/cyan"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textEndTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ora di fine: non impostata"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonPickEndTime"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Imposta ora di fine"
                android:textAllCaps="false"
                android:textColor="@color/cyan"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonAutoSearch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_primary"
                android:text="Attiva avvio programmato"
                android:textAllCaps="false"
                android:textColor="@color/navy"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Filtri dei 7 PDF"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSearchDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Data automatica"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/searchPanelsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/buttonSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_button_primary"
            android:text="Salva impostazioni"
            android:textAllCaps="false"
            android:textColor="@color/navy"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonBackMain"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Torna alla schermata principale"
            android:textAllCaps="false"
            android:textColor="@color/cyan"
            android:textStyle="bold" />

        <!-- Controlli mantenuti invisibili per la logica delle versioni precedenti. -->
        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/textGlobalSearchStatus" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/textNextSearch" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/buttonSearchNow" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/buttonNewSearch" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/buttonShareAll" android:layout_width="1dp" android:layout_height="1dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
